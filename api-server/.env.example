# OAuth configuration for the MOPH Provider ID / Health ID exchange.
# Set these as Vercel project env vars (vercel env add), not in a committed file.
#
# URLs (from official MOPH manual):
# PRD: HEALTH_ID_URL=https://moph.id.th        PROVIDER_ID_URL=https://provider.id.th
# UAT: HEALTH_ID_URL=https://uat-moph.id.th    PROVIDER_ID_URL=https://uat-provider.id.th

HEALTH_ID_URL=https://moph.id.th
HEALTH_CLIENT_ID=your_health_client_id_here
HEALTH_CLIENT_SECRET=your_health_client_secret_here
PROVIDER_ID_URL=https://provider.id.th
PROVIDER_CLIENT_ID=your_provider_client_id_here
PROVIDER_CLIENT_SECRET=your_provider_secret_key_here

# Must exactly match (a) the redirect URI registered with MOPH for this
# client_id, and (b) this deployment's own callback route below.
# e.g. https://<your-vercel-domain>/api/auth/health-id/callback
PROVIDER_REDIRECT_URI=

# The Firebase Hosting site staff get redirected back to after login.
FRONTEND_URL=https://khh-primary-happinometer.web.app

# Supabase project (Project Settings > API). service_role bypasses RLS —
# never expose it to the frontend, only set it here on the backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
