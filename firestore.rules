rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /happinometer_responses/{document=**} {
      // Anyone can submit anonymously — the survey has no login.
      allow create: if true;
      // Only an authenticated, approved admin/superadmin (custom claims minted
      // by the provider-login Cloud Function) can read aggregate responses.
      allow read: if request.auth != null
                   && request.auth.token.approved == true
                   && request.auth.token.role in ['admin', 'superadmin'];
      allow update, delete: if false;
    }

    match /khh_staff/{staffId} {
      // A signed-in staff member may read only their own record (e.g. to see
      // pending/approved status). All writes happen from the Cloud Function
      // via the Admin SDK, which bypasses these rules entirely.
      allow read: if request.auth != null && request.auth.uid == staffId;
      allow write: if false;
    }
  }
}
