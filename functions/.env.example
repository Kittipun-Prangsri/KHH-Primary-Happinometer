# Non-secret OAuth configuration for the MOPH Provider ID / Health ID exchange.
# Copy this file to functions/.env and fill in real values.
#
# URLs (from official MOPH manual, "คู่มือการเชื่อมต่อระบบ Provider ID ด้วย OAuth ของ Health ID"):
# PRD: HEALTH_ID_URL=https://moph.id.th        PROVIDER_ID_URL=https://provider.id.th
# UAT: HEALTH_ID_URL=https://uat-moph.id.th    PROVIDER_ID_URL=https://uat-provider.id.th

HEALTH_ID_URL=https://moph.id.th
HEALTH_CLIENT_ID=your_health_client_id_here
HEALTH_CLIENT_SECRET=your_health_client_secret_here
PROVIDER_ID_URL=https://provider.id.th
PROVIDER_CLIENT_ID=your_provider_client_id_here
PROVIDER_CLIENT_SECRET=your_provider_secret_key_here

# Must exactly match both (a) the redirect URI registered with MOPH for this
# app, and (b) the callback route this backend actually exposes below
# (GET /api/auth/health-id/callback) — otherwise Health ID either rejects the
# request with "Redirect uri is invalid" or successfully redirects the user
# to a URL this backend never handles.
PROVIDER_REDIRECT_URI=https://khh-primary-happinometer.web.app/api/auth/health-id/callback
