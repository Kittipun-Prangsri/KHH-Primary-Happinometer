# Non-secret OAuth configuration for the MOPH Provider ID / Health ID exchange.
# Copy this file to functions/.env and fill in real values.
#
# Production URLs (from official MOPH manual):
# HEALTH_ID_URL=https://healthid.moph.go.th
# PROVIDER_ID_URL=https://provider.id.th (or https://provider.moph.go.th)
#
# UAT Testing URLs:
# PROVIDER_ID_URL=https://uat-provider.id.th

HEALTH_ID_URL=https://healthid.moph.go.th
HEALTH_CLIENT_ID=your_health_client_id_here
PROVIDER_ID_URL=https://provider.id.th
PROVIDER_CLIENT_ID=your_provider_client_id_here

# Must exactly match the redirect URI registered with MOPH for this app.
PROVIDER_REDIRECT_URI=https://khh-primary-happinometer.web.app
