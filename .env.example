# Base URL of the backend that performs the MOPH Provider ID / Health ID OAuth
# token exchange (GET /api/auth/login-url, GET /api/auth/health-id/callback) —
# see api-server/, deployed separately on Vercel.
# This frontend never talks to MOPH directly and never holds OAuth client secrets —
# those must only ever live server-side (see .env for local values, gitignored).
VITE_API_BASE_URL=https://your-khh-backend.example.com/api

# Supabase project (Project Settings > API). The anon key is safe to expose
# client-side by design — RLS policies (see supabase/migrations) are what
# actually restrict access, not secrecy of this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
